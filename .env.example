# Server Configuration
PORT=

# MongoDB Configuration
# Atlas connection string. Never commit a real value to this file.
MONGODB_URI=

# Session signing secret (required)
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Anthropic API key for AI synthesis and semantic clustering
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
